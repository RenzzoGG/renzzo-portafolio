{
  "name": "renzzogg-portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "check:contrast": "node scripts/check-contrast.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run check:contrast && npm run build",
    "cv:pdf": "node scripts/cv-pdf.ts",
    "og:image": "node scripts/og-image.ts",
    "check:budgets": "node scripts/check-budgets.ts",
    "test:e2e": "npm run build && playwright test --project=chromium",
    "test:firefox": "npm run build && playwright test --project=firefox",
    "test:webkit": "npm run build && playwright test --project=webkit",
    "lighthouse": "node scripts/lighthouse.ts",
    "face:build": "node scripts/face/run.ts"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "astro": "7.4.13",
    "axe-core": "4.14.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.14.0",
    "gsap": "3.15.1",
    "lighthouse": "13.6.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "three": "0.187.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
