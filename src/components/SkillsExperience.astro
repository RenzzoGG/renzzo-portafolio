---
import {
  getCertifications,
  getEducation,
  getProfile,
  getSkills,
} from "../lib/content.ts";
import ExternalLink from "./ExternalLink.astro";

const { ui, platzi } = await getProfile();
const skills = await getSkills();
const education = await getEducation();
const certifications = await getCertifications();
---

<section class="section container" id="skills" aria-labelledby="skills-title">
  <h2 class="section-title" id="skills-title">
    {ui.headings.skills}
  </h2>
  <div class="grid">
    <dl class="skills">
      {skills.map(({ data }) => (
        <div>
          <dt>{data.group}</dt>
          <dd>{data.items.join(", ")}</dd>
        </div>
      ))}
    </dl>

    <div class="side">
      <div>
        <h3>{ui.headings.education}</h3>
        {education.map(({ data }) => (
          <div class="edu">
            <p class="edu__title">{data.title}</p>
            {data.titleEs && <p lang="es">{data.titleEs}</p>}
            <p>
              {data.organization} · {data.status}
            </p>
          </div>
        ))}
      </div>
      <div>
        <h3>{ui.headings.certifications}</h3>
        <ul class="certs">
          {certifications.map(({ data }) => (
            <li>{data.title}</li>
          ))}
        </ul>
        <ExternalLink class="platzi" href={platzi.url}>
          {platzi.label}
        </ExternalLink>
      </div>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: var(--space-7);
    margin-top: var(--space-6);
  }

  .skills {
    display: grid;
    align-content: start;
  }

  .skills > div {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  dt {
    font-weight: var(--weight-medium);
  }

  dd {
    color: var(--color-muted);
    line-height: var(--leading-snug);
  }

  .side {
    display: grid;
    align-content: start;
    gap: var(--space-6);
  }

  h3 {
    font-size: var(--text-subheading);
  }

  .edu {
    margin-top: var(--space-3);
    color: var(--color-muted);
    font-size: var(--text-small);
    line-height: var(--leading-snug);
  }

  .edu__title {
    color: var(--color-text);
    font-size: var(--text-body);
    font-weight: var(--weight-medium);
  }

  .certs {
    margin-block: var(--space-3);
    padding: 0;
    list-style: none;
    color: var(--color-muted);
    font-size: var(--text-small);
    line-height: 1.7;
  }

  .platzi {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--text-small);
    text-decoration-line: underline;
  }

  @media (min-width: 48rem) {
    .skills > div {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: var(--space-5);
    }

    .certs {
      columns: 2;
      column-gap: var(--space-5);
    }
  }

  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-8);
    }

    .certs {
      columns: 1;
    }
  }
</style>
