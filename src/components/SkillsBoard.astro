---
import { getProfile, getSkills } from "../lib/content.ts";

const { ui } = await getProfile();
const skills = await getSkills();
---

<div class="board" data-board>
  <div
    class="board__tabs"
    role="tablist"
    aria-label={ui.sets.skillsTabs}
    hidden
  >
    {skills.map(({ id, data }, index) => (
      <button
        type="button"
        role="tab"
        id={`skill-tab-${id}`}
        aria-controls={`skill-panel-${id}`}
        aria-selected={index === 0 ? "true" : "false"}
        tabindex={index === 0 ? 0 : -1}
      >
        {data.tab}
      </button>
    ))}
  </div>

  <div class="board__display" data-board-display aria-hidden="true" hidden>
    <canvas></canvas>
  </div>

  <div class="board__panels">
    {skills.map(({ id, data }) => (
      <div class="board__panel" id={`skill-panel-${id}`}>
        <h3>{data.group}</h3>
        <ul>
          {data.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</div>

<script>
  const load = () => void import("../lib/ui/tabs.ts");
  if ("requestIdleCallback" in window) {
    requestIdleCallback(load, { timeout: 1500 });
  } else {
    setTimeout(load, 200);
  }
</script>

<style>
  .board {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
  }

  .board__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .board__tabs[hidden],
  .board__display[hidden] {
    display: none;
  }

  [role="tab"] {
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-xs);
    background: var(--color-surface);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  [role="tab"][aria-selected="true"] {
    border-color: var(--color-signal);
    background: var(--color-signal);
    color: var(--color-on-signal);
  }

  @media (hover: hover) {
    [role="tab"]:not([aria-selected="true"]):hover {
      border-color: var(--color-text);
      background: var(--color-surface-hover);
    }
  }

  .board__display {
    padding: var(--space-3);
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-ink);
  }

  canvas {
    display: block;
    width: 100%;
  }

  .board__panels {
    display: grid;
    gap: var(--space-5);
  }

  /* All panels share one cell once enhanced, so tabs never shift the layout. */
  [data-ready] .board__panels > * {
    grid-area: 1 / 1;
  }

  [data-ready] .board__panel[data-inactive] {
    visibility: hidden;
  }

  h3 {
    margin-bottom: var(--space-2);
    font-size: var(--text-body);
    font-weight: var(--weight-medium);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    padding: 0;
    list-style: none;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    line-height: var(--leading-snug);
  }
</style>
