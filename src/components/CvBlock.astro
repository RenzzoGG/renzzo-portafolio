---
import { getCvLink, getProfile } from "../lib/content.ts";

const profile = await getProfile();
const { ui } = profile;
const cv = getCvLink(profile);
---

<section class="section container cv-block" id="cv" aria-labelledby="cv-title">
  <h2 class="section-title" id="cv-title">
    {ui.headings.cv}
  </h2>
  <div class="actions">
    <a class="btn" href={cv.href} download>
      {ui.cvActions.download}
    </a>
    <a class="btn btn--ghost" href="/cv/">
      {ui.cvActions.view}
    </a>
  </div>
</section>

<style>
  .cv-block {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }
</style>
