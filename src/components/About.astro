---
import { getProfile, getProjects } from "../lib/content.ts";
import HudMarks from "./HudMarks.astro";
import NoBreak from "./NoBreak.astro";
import SegmentDisplay from "./SegmentDisplay.astro";

const { about, location, remote, languages, ui } = await getProfile();
const { all } = await getProjects();
// Paragraph breaks only: the approved wording stays in one profile field.
const paragraphs = about.split(/ (?=Clearline Dental is|I also care|I deploy)/);
const facts = [
  [ui.facts.location, location],
  [ui.facts.work, remote],
  [ui.facts.languages, languages],
];
const { terminalTitle, terminalCommand, counters } = ui.sets;
const readouts = [
  { value: String(all.length), label: counters.projects },
  { value: counters.testsValue, label: counters.tests },
  { value: counters.lighthouseValue, label: counters.lighthouse },
];
---

<section class="about" id="about" aria-labelledby="about-title" data-act>
  <div class="container">
    <HudMarks index={2} total={6} />
  </div>
  <div class="container about__inner">
    <h2
      class="section-title"
      id="about-title"
      data-reveal
      data-glitch={ui.headings.about}
    >
      {ui.headings.about}
    </h2>
    <div class="about__panel">
      <div class="term" data-act-item="body">
        <div class="term__bar" aria-hidden="true">
          <span class="term__lights">
            <i></i>
            <i></i>
            <i></i>
          </span>
          <span>{terminalTitle}</span>
        </div>
        <div class="term__body" data-type>
          <p class="term__command" aria-hidden="true">
            {terminalCommand}
          </p>
          {paragraphs.map((paragraph) => (
            <p class="justify" data-type-line>
              <NoBreak text={paragraph} />
            </p>
          ))}
        </div>
      </div>

      <div class="about__side" data-act-item="detail">
        <ul class="about__counters">
          {readouts.map((item) => (
            <li>
              <SegmentDisplay value={item.value} /> <span>{item.label}</span>
            </li>
          ))}
        </ul>
        <dl class="about__facts">
          {facts.map(([term, value]) => (
            <div>
              <dt>{term}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
    padding-block: var(--section-gap);
    overflow: clip;
    background: var(--color-surface);
  }

  .about__inner {
    position: relative;
    display: grid;
    gap: var(--space-5);
  }

  /* The streams pass behind the solid terminal, so text never depends on them. */
  :global(:root[data-world-live]) .about {
    background: transparent;
  }

  .about__panel {
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }

  .term {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    box-shadow: 0 28px 56px -32px rgb(0 0 0 / 0.95);
  }

  .term__bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-raised);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
  }

  .term__lights {
    display: inline-flex;
    gap: var(--space-1);
  }

  .term__lights i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-full);
    background: var(--color-border-strong);
  }

  .term__lights i:first-child {
    background: var(--color-glow);
  }

  .term__body {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }

  .term__body p {
    position: relative;
    max-width: 56ch;
  }

  .term__command {
    color: var(--color-glow);
    font-family: var(--font-mono);
    font-size: var(--text-small);
  }

  .about__side {
    display: grid;
    align-content: start;
    gap: var(--space-5);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .about__counters {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
    font-size: var(--text-small);
    line-height: var(--leading-snug);
  }

  .about__counters li {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    align-items: center;
    gap: var(--space-3);
  }

  .about__facts {
    display: grid;
    gap: var(--space-3);
    font-size: var(--text-small);
    line-height: var(--leading-snug);
  }

  dt {
    color: var(--color-muted);
    font-size: var(--text-caption);
  }

  /* Without WebGL, a light CSS stream keeps the section alive. */
  .about::before {
    content: "";
    position: absolute;
    inset: -40% 0 0;
    background: repeating-linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-signal) 42%, transparent) 0 1px,
      transparent 1px 22px
    );
    mask-image: linear-gradient(to right, black, transparent 45%, black);
    opacity: 0.55;
    pointer-events: none;
  }

  :global(:root[data-world-live]) .about::before {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(:root:not([data-motion="off"])) .about::before {
      animation: about-stream 9s linear infinite;
    }
  }

  @keyframes about-stream {
    to {
      transform: translateY(22px);
    }
  }

  /*
   * Heading, readouts and facts share the left column. The terminal keeps a
   * comfortable measure on the right. The DOM order stays heading, bio, facts.
   */
  @media (min-width: 64rem) {
    .about__inner {
      --term-width: calc(56ch + 2 * var(--space-5) + 2px);

      grid-template-columns: minmax(17rem, 1fr) minmax(0, var(--term-width));
      grid-template-rows: auto 1fr;
      column-gap: var(--space-7);
      font-size: var(--text-body);
    }

    .about__panel {
      display: contents;
    }

    .term {
      grid-column: 2;
      grid-row: 1 / span 2;
    }

    /* The readouts share the spare height, so the panel has no dead strip. */
    .about__side {
      grid-column: 1;
      grid-row: 2;
      grid-template-rows: 1fr auto;
      align-content: stretch;
    }

    .about__counters {
      align-content: space-between;
    }
  }
</style>
