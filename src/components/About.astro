---
import { getProfile } from "../lib/content.ts";
import HudMarks from "./HudMarks.astro";

const { about, location, remote, languages, ui } = await getProfile();
// Paragraph breaks only: the approved wording stays in one profile field.
const paragraphs = about.split(/ (?=Clearline Dental is|I also care|I deploy)/);
const facts = [
  [ui.facts.location, location],
  [ui.facts.work, remote],
  [ui.facts.languages, languages],
];
---

<section class="about" id="about" aria-labelledby="about-title">
  <div class="container">
    <HudMarks index={2} total={6} />
  </div>
  <div class="container about__inner">
    <h2
      class="section-title"
      id="about-title"
      data-reveal
      data-glitch={ui.headings.about}
    >
      {ui.headings.about}
    </h2>
    <div class="about__panel">
      <div class="about__text">
        {paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
      <dl class="about__facts">
        {facts.map(([term, value]) => (
          <div>
            <dt>{term}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: var(--section-gap);
    background: var(--color-surface);
  }

  .about__inner {
    display: grid;
    gap: var(--space-5);
  }

  /* The streams pass behind this panel, so body text never depends on them. */
  :global(:root[data-world-live]) .about {
    background: transparent;
  }

  :global(:root[data-world-live]) .about__panel {
    padding: var(--space-6);
    background: var(--color-surface);
  }

  .about__text {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure-body);
    font-size: var(--text-lead);
    line-height: var(--leading-body);
  }

  .about__facts {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  dt {
    color: var(--color-muted);
    font-size: var(--text-small);
  }

  @media (min-width: 48rem) {
    .about__facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .about__inner {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }
  }
</style>
