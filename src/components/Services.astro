---
import { getProfile, getServices } from "../lib/content.ts";
import NoBreak from "./NoBreak.astro";
import DotIcon from "./DotIcon.astro";
import HudMarks from "./HudMarks.astro";

const { ui, servicesLink } = await getProfile();
const services = await getServices();
const ICONS = ["rack", "page", "fix"] as const;
const pad = (value: number) => String(value).padStart(2, "0");
---

<section
  class="services"
  id="services"
  aria-labelledby="services-title"
  data-act
>
  <div class="container">
    <HudMarks index={3} total={6} />
    <div class="services__head">
      <h2
        class="section-title"
        id="services-title"
        data-reveal
        data-glitch={ui.headings.services}
      >
        {ui.headings.services}
      </h2>
      <a class="btn btn--ghost" href={servicesLink.href}>
        {servicesLink.label}
      </a>
    </div>
    <ul class="services__list">
      {services.map(({ data }, index) => (
        <li class="channel" data-channel data-act-item="body">
          <div class="channel__monitor" aria-hidden="true">
            <div class="channel__screen">
              <div class="channel__picture">
                <span class="channel__icon">
                  <DotIcon name={ICONS[index] ?? "rack"} />
                </span>
              </div>
              <span class="crt-raster" />
              <span class="channel__number">
                {ui.sets.channel} {pad(index + 1)}
              </span>
            </div>
          </div>
          <h3>{data.title}</h3>
          <p>
            <NoBreak text={data.text} />
          </p>
          <ul class="stack-list" aria-label={`${data.title} stack`}>
            {data.stack.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <a class="channel__link" href={servicesLink.href}>
            {servicesLink.label}
            <span class="visually-hidden">: {data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services {
    padding-block: var(--section-gap);
    background: var(--color-surface);
  }

  .services__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .services__list {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-6);
    padding: 0;
    list-style: none;
  }

  .channel {
    display: grid;
    grid-template-rows: auto auto 1fr auto auto;
    gap: var(--space-3);
    min-width: 0;
  }

  .channel__monitor {
    margin-bottom: var(--space-2);
    padding: var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-xl);
    background: var(--color-surface-raised);
    box-shadow: 0 22px 36px -26px rgb(0 0 0 / 0.95);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .channel__screen {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-ink);
  }

  .channel__picture {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0.58;
    transition: opacity var(--duration-base) var(--ease-out);
  }

  .channel__number {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 3;
    color: var(--color-glow);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: 0.08em;
  }

  .channel__icon {
    width: clamp(4.5rem, 34%, 6.5rem);
    aspect-ratio: 1;
  }

  h3 {
    font-size: var(--text-subheading);
  }

  p {
    max-width: var(--measure-narrow);
    color: var(--color-muted);
    line-height: var(--leading-snug);
  }

  .channel__link {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    min-height: 2.75rem;
    font-size: var(--text-small);
    text-decoration-line: underline;
  }

  .channel:is(:hover, :focus-within, [data-on]) .channel__monitor {
    border-color: var(--color-glow);
  }

  .channel:is(:hover, :focus-within, [data-on]) .channel__picture {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(:root:not([data-motion="off"]))
      .channel:is(:hover, :focus-within, [data-on])
      .channel__picture {
      animation: crt-on 420ms var(--ease-out) both;
    }

    @media (hover: none) {
      :global(:root:not([data-motion="off"]))
        .channel[data-on]
        .channel__picture {
        animation: crt-soft 680ms var(--ease-out) both;
      }
    }

    :global(:root:not([data-motion="off"]))
      .channel:is(:hover, :focus-within, [data-on])
      .channel__icon
      :global(.dot-icon__a) {
      animation: dot-a 1.3s steps(1, end) 420ms infinite;
    }

    :global(:root:not([data-motion="off"]))
      .channel:is(:hover, :focus-within, [data-on])
      .channel__icon
      :global(.dot-icon__b) {
      animation: dot-b 1.3s steps(1, end) 420ms infinite;
    }
  }

  @keyframes dot-a {
    0% {
      stroke: var(--color-led-off);
    }

    50% {
      stroke: var(--color-glow);
    }
  }

  @keyframes dot-b {
    0% {
      stroke: var(--color-glow);
    }

    50% {
      stroke: var(--color-led-off);
    }
  }

  @media (min-width: 48rem) {
    .services__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }
</style>
