---
import { getProfile, getProjects } from "../lib/content.ts";
import "../styles/detail.css";
import "../styles/work.css";
import MoreWork from "./MoreWork.astro";
import ProjectCase from "./ProjectCase.astro";
import WorkIndex from "./WorkIndex.astro";

const { ui } = await getProfile();
const { featured } = await getProjects();
---

<div class="signal-tunnel" data-signal-tunnel aria-hidden="true"></div>
<section class="work" id="work" aria-labelledby="work-title">
  <div class="work__stage" data-tone="bone" data-work-stage>
    <div class="container work__grid">
      <h2
        class="section-title work__title"
        id="work-title"
        data-glitch={ui.headings.work}
      >
        {ui.headings.work}
      </h2>
      <div class="work__rail">
        <WorkIndex projects={featured} />
      </div>
      <div class="work__cases" data-screens>
        {featured.map((project, index) => (
          <ProjectCase
            {project}
            reverse={index % 2 === 1}
            number={index + 1}
            total={featured.length}
          />
        ))}
      </div>
    </div>
  </div>
  <div class="work__more">
    <div class="container">
      <MoreWork />
    </div>
  </div>
</section>
<dialog
  class="detail-dialog"
  aria-label={ui.project.caseStudy}
  data-detail-dialog
></dialog>

<script>
  import "../lib/ui/detail.ts";
</script>
