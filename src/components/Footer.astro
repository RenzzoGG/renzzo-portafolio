---
import { getProfile } from "../lib/content.ts";

const { footer } = await getProfile();
const text = footer.replace("{year}", String(new Date().getFullYear()));
---

<footer class="footer" data-print-hide>
  <p class="container">{text}</p>
</footer>

<style>
  .footer {
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: var(--text-small);
  }
</style>
