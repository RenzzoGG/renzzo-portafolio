---
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import CvBlock from "../components/CvBlock.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import SkillsExperience from "../components/SkillsExperience.astro";
import Work from "../components/Work.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getProfile } from "../lib/content.ts";

const { meta } = await getProfile();
---

<BaseLayout title={meta.title} description={meta.description}>
  <Hero />
  <About />
  <Work />
  <Services />
  <SkillsExperience />
  <CvBlock />
  <Contact />
</BaseLayout>
